# Optional. Copy to .env to turn the leaderboard on: src/lib/supabase.ts reads both at build time, and with either
# missing the game builds and plays with no leaderboard. The Supabase project this game was built against no longer
# exists (arcade#65), so with real-looking values the leaderboard calls just fail.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
