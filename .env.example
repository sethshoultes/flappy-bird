# Copy to .env. Both are read by src/lib/supabase.ts at build time, and the game does not load without them.
# The Supabase project this game was built against no longer exists (arcade#65), so the leaderboard calls fail
# whatever the values are; they only have to be present until that is decided.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
